# Telegram MTProto Userbot Credentials (from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_PHONE=+79990000000
TELEGRAM_SESSION_PATH=data/session/userbot.session

# Optional Telegram Bot API token (used only for auxiliary integration smoke checks)
TELEGRAM_BOT_TOKEN=

# Antigravity OAuth & Binary Isolation
ANTIGRAVITY_DATA_DIR=data/antigravity
ANTIGRAVITY_BINARY=/home/jeff/.local/bin/agy
# Optional explicit proxy for Antigravity subprocesses
ANTIGRAVITY_PROXY=

# Optional Gemini API key for vector memory embeddings
GEMINI_API_KEY=your_gemini_api_key_here
