# Telegram MTProto Userbot Credentials
# Obtain api_id and api_hash from https://my.telegram.org -> "API development tools"
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: Account phone number for automated login prompt (+XXXXXXXXXXX)
TELEGRAM_PHONE=

# Path to the Telethon MTProto session file (must be mode 0600 in mode 0700 dir)
TELEGRAM_SESSION_PATH=data/session/userbot.session

# Antigravity Isolated Environment & Token Directory
ANTIGRAVITY_DATA_DIR=data/antigravity
ANTIGRAVITY_BINARY=/usr/local/bin/agy

# Optional: Dedicated proxy for Antigravity subprocesses (e.g. socks5://127.0.0.1:1080)
ANTIGRAVITY_PROXY=
